{
  "name": "brisa",
  "version": "0.3.4",
  "description": "Recopilador y gestor de ports nativos de PC al estilo EmuDeck, basado en manifiestos.",
  "license": "MIT",
  "author": "Kanin",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "brisa": "dist/cli.js"
  },
  "main": "dist/desktop/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "serve": "node dist/cli.js serve",
    "desktop": "npm run build && electron .",
    "package": "npm run build && node scripts/build-desktop.mjs",
    "package:linux": "npm run build && node scripts/build-desktop.mjs --only linux",
    "package:windows": "npm run build && node scripts/build-desktop.mjs --only windows"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^12.1.0",
    "tar": "^6.2.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.1",
    "@types/tar": "^6.1.13",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}