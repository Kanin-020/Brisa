{
  "id": "ghostship",
  "name": "GhostShip",
  "game": "Super Mario 64",
  "description": "Native PC port of Super Mario 64 built on the decompilation of the original game.",
  "repo": "HarbourMasters/Ghostship",
  "roms": [
    {
      "id": "sm64",
      "name": "Super Mario 64",
      "patterns": ["*.z64", "*.n64", "*.v64", "sm64.z64", "sm.n64", "sm.v64"],
      "sha1": [
        "9bef1128717f958171a4afac3ed78ee2bb4e86ce",
        "8a20a5c83d6ceb0f0506cfc9fa20d8f438cafe51",
        "4ac5721683d0e0b6bbb561b58a71740845dceea9"
      ],
      "gameIds": [],
      "dest": "sm64.z64"
    }
  ],
  "assets": {
    "linux-x64": {
      "pattern": "*-Linux.zip",
      "type": "zip",
      "executable": "ghostship.appimage"
    },
    "windows-x64": {
      "pattern": "*-Win64.zip",
      "type": "zip",
      "executable": "Ghostship.exe"
    }
  },
  "mods": {
    "dir": "mods",
    "gameDir": "ghostship"
  },
  "preserve": ["saves/**", "ghostship.cfg.json"]
